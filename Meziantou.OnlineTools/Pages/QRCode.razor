@page "/qr-code"
<h1>QR Code generator</h1>

<div>
    <label for="qrCodeType">QR Code type</label>
    <select id="qrCodeType" class="form-control" @onchange="OnQRCodeTypeChanged">
        <option value="@QRCodeGenerationType.Standard">Standard</option>
        <option value="@QRCodeGenerationType.MicroQR">Micro QR</option>
        <option value="@QRCodeGenerationType.Mnqr">MNQR (rMQR)</option>
    </select>
</div>

<textarea class="form-control code" @oninput="OnTextInput"></textarea>
<button type="button" @onclick="Click">Generate</button>

<div>
    @(new MarkupString(qrcode ?? ""))
</div>

<h2>Examples</h2>
<div>
    <ul>
        <li><code>https://example.com</code></li>
        <li><code>mailto:john.doe@example.com?subject=sample&body=sample</code></li>
        <li><code>tel:+1234567890</code></li>
        <li><code>SMSTO:+1234567890:message</code></li>
        <li><code>WIFI:T:WPA;S:WIFI_SSID;P:Pa$$w0rd</code></li>
        <li>VCard: <a href="https://en.wikipedia.org/wiki/VCard#Example">https://en.wikipedia.org/wiki/VCard#Example</a></li>
    </ul>
</div>


@code {
    string text = "";
    string? qrcode;
    QRCodeGenerationType qrCodeType = QRCodeGenerationType.Standard;

    public QRCode()
    {
        GenerateQRCode();
    }

    void Click()
    {
        GenerateQRCode();
        StateHasChanged();
    }

    void OnTextInput(ChangeEventArgs e)
    {
        text = e.Value?.ToString() ?? "";
        GenerateQRCode();
    }

    void OnQRCodeTypeChanged(ChangeEventArgs e)
    {
        qrCodeType = Enum.Parse<QRCodeGenerationType>(e.Value?.ToString() ?? nameof(QRCodeGenerationType.Standard), ignoreCase: true);
        GenerateQRCode();
    }

    void GenerateQRCode()
    {
        if (string.IsNullOrEmpty(text))
        {
            qrcode = null;
            return;
        }

        var generatedQRCode = qrCodeType switch
        {
            QRCodeGenerationType.MicroQR => global::Meziantou.Framework.QRCode.CreateMicroQR(text, global::Meziantou.Framework.ErrorCorrectionLevel.Q),
            QRCodeGenerationType.Mnqr => global::Meziantou.Framework.QRCode.CreateRMQR(text, global::Meziantou.Framework.ErrorCorrectionLevel.M),
            _ => global::Meziantou.Framework.QRCode.Create(text, global::Meziantou.Framework.ErrorCorrectionLevel.Q),
        };

        qrcode = global::Meziantou.Framework.QRCodeSvgRenderer.ToSvg(generatedQRCode, new global::Meziantou.Framework.QRCodeSvgOptions
        {
            ModuleSize = 10,
        });
    }

    enum QRCodeGenerationType
    {
        Standard,
        MicroQR,
        Mnqr,
    }
}
