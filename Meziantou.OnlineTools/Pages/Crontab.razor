@page "/crontab"
@using Meziantou.Framework.Scheduling

<h1>Crontab</h1>
<p><a href="https://github.com/meziantou/Meziantou.Framework/blob/main/src/Meziantou.Framework.Scheduling/readme.md">Crontab documentation</a></p>

<input class="form-control code" list="expressions" @bind="text" />
<datalist id="expressions">
    <option value="* * * * *" />
</datalist>

<div>
    <button class="btn btn-secondary" @onclick="Compute">Get occurences</button>
</div>

@if (result != null)
{
<pre class="result">@result</pre>
}

@code {
    string? text = "* * * * *";
    string? result;

    void Compute()
    {
        try
        {
            var schedule = CronExpression.Parse(text ?? "");
#pragma warning disable RS0030 // Do not use banned APIs
            result = string.Join('\n', schedule.GetNextOccurrences(DateTime.Now).Take(50));
#pragma warning restore RS0030
        }
        catch (Exception ex)
        {
            result = ex.Message;
        }
    }
}