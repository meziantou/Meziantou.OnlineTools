@page "/numbers"
@using Meziantou.Framework
@using System.Numerics
@inject NavigationManager NavigationManager

<h1>Number</h1>

<input class="form-control code" @oninput="OnInput" value="@Text" />


@if (result != null)
{
    <ResultValueList Values="GetResultValues(result.Value)" />
}

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? Text { get; set; }

    long? result;

    protected override void OnParametersSet()
    {
        Compute();
    }

    void OnInput(ChangeEventArgs e)
    {
        Text = e.Value as string;
        Compute();
    }

    void Compute()
    {
        NavigationManager.UpdateUrlUsingParameters(this, replaceHistory: true);

        if (long.TryParse(Text, out var result))
        {
            this.result = result;
        }
        else
        {
            this.result = null;
        }
    }

    string SplitGroup(string text, int blockSize)
    {
        if (string.IsNullOrEmpty(text))
            return "";

        var newString = "";
        var i = text.Length;
        while (true)
        {
            if (newString != "")
            {
                newString = " " + newString;
            }

            newString = text.Substring(Math.Max(0, i - blockSize), Math.Min(i, blockSize)) + newString;

            i -= blockSize;
            if (i <= 0)
                break;
        }

        return newString;
    }

    IReadOnlyList<ResultValue> GetResultValues(long value)
    {
        return
        [
            new("Decimal (10)", SplitGroup(value.ToString(), 3)),
            new("Hexadecimal (16)", SplitGroup(value.ToString("X"), 4)),
            new("Octal (8)", SplitGroup(Convert.ToString(value, toBase: 8), 3)),
            new("Binary (2)", SplitGroup(Convert.ToString(value, toBase: 2), 4)),
        ];
    }
}