@page "/nato-alphabet"

<h1>String to NATO alphabet</h1>

<p>Convert text to the NATO phonetic alphabet (ICAO). Spaces are represented as <code>/</code>.</p>

<div class="form-group">
    <label for="value">Value</label>
    <textarea id="value" class="form-control code" @oninput="OnInputChanged">@value</textarea>
</div>

<ResultValueSingle CopyLabel="NATO alphabet" Value="@result" />

@code {
    private string value = string.Empty;
    private string result = string.Empty;

    protected override void OnInitialized()
    {
        Compute();
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        value = e.Value?.ToString() ?? string.Empty;
        Compute();
    }

    private void Compute()
    {
        result = TextEncodingUtils.ToNatoAlphabet(value);
    }
}
