@page "/record-screen"
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<h1>Record screen</h1>

<p>Record a screen, window, or browser tab. The recording stays in your browser.</p>

<div class="recording-options">
    <label>
        <input type="checkbox" @bind="includeSystemAudio" disabled="@isRecording" />
        Include system audio
    </label>
    <label>
        <input type="checkbox" @bind="includeMicrophone" disabled="@isRecording" />
        Include microphone
    </label>
</div>

<div class="recording-controls">
    <button type="button" class="btn btn-primary" @onclick="StartAsync" disabled="@isRecording">Start</button>
    <button type="button" class="btn btn-secondary" @onclick="StopAsync" disabled="@(!isRecording)">Stop</button>
    @if (isRecording)
    {
        <span class="recording-status">Recording...</span>
    }
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (recording != null)
{
    <div class="recording-result">
        <video controls src="@recording.Url"></video>
        <button type="button" class="btn btn-primary" @onclick="DownloadAsync">Download video</button>
    </div>
}

@code {
    private IJSObjectReference? module;
    private DotNetObjectReference<RecordScreen>? dotNetReference;
    private bool includeSystemAudio = true;
    private bool includeMicrophone;
    private bool isRecording;
    private string? errorMessage;
    private RecordingResult? recording;

    private async Task StartAsync()
    {
        errorMessage = null;
        recording = null;
        dotNetReference ??= DotNetObjectReference.Create(this);

        try
        {
            await (await GetModuleAsync()).InvokeVoidAsync("start", includeSystemAudio, includeMicrophone, dotNetReference);
            isRecording = true;
        }
        catch (JSException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task StopAsync()
    {
        errorMessage = null;

        try
        {
            recording = await (await GetModuleAsync()).InvokeAsync<RecordingResult>("stop");
        }
        catch (JSException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRecording = false;
        }
    }

    [JSInvokable]
    public async Task OnRecordingStopped(RecordingResult result)
    {
        recording = result;
        isRecording = false;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnRecordingFailed(string message)
    {
        errorMessage = message;
        isRecording = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadAsync()
    {
        if (recording != null)
        {
            await (await GetModuleAsync()).InvokeVoidAsync("download", recording.Url, recording.FileName);
        }
    }

    private async Task<IJSObjectReference> GetModuleAsync()
    {
        module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/screen-recorder.js");
        return module;
    }

    public async ValueTask DisposeAsync()
    {
        if (module != null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetReference?.Dispose();
    }

    public sealed class RecordingResult
    {
        public string Url { get; set; } = "";
        public string FileName { get; set; } = "";
        public string MimeType { get; set; } = "";
    }
}
